# Copy to .env on your server/Render and fill in real values.
# Local default (keep as-is for development).

# Backend API port - Render injects PORT automatically, leave unset there.
PORT=10000

NODE_ENV=production

# Comma-separated list of allowed browser origins.
CLIENT_URL=https://velmora-web.onrender.com

# MongoDB - REQUIRED on Render. Use a MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ecommerce
MONGO_DB_NAME=ecommerce

# Auth - REQUIRED. Generate with: openssl rand -hex 32
# The server refuses to start with a missing/short/placeholder secret.
JWT_SECRET=replace_with_a_random_32_character_secret
JWT_EXPIRES_IN=30d

# Admin seed (used by `npm run seed:all`) - REQUIRED, min 12 chars & not a
# common weak password. Never reuse this anywhere else.
ADMIN_EMAIL=admin@velmora.com
ADMIN_PASSWORD=replace_with_a_strong_unique_admin_password