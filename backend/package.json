{
  "name": "velmora-backend",
  "version": "1.0.0",
  "description": "Velmora E-Commerce REST API built with Node.js, Express and MongoDB",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node utils/seedAdmin.js",
    "seed:data": "node utils/seedData.js",
    "seed:extra": "node utils/addProducts.js",
    "seed:all": "node utils/seedAdmin.js && node utils/seedData.js && node utils/addProducts.js"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mongodb",
    "mongoose",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}